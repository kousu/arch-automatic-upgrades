#!/bin/bash
# Upgrade the system including AUR packages.

set -e

usage() {
	echo "usage: $0 [-q]" >&2
	echo "  -q  quick check: only rebuild AUR packages dependent on packages updated since" >&2
	echo "      since the last automatic upgrade or the last boot, whichever came last. Otherwise" >&2
	echo "      every package is scanned as a potential cause of problems for your AUR packages" >&2
	echo "      and you don't want that ... unless you do cuz you've rebooted into a semi-broken system." >&2
	exit 2
}

quick=
while getopts q opt; do
	case $opt in
	q) quick=1 ;;
	*) usage ;;
	esac
done
shift $((OPTIND - 1))
[ $# -eq 0 ] || usage

# this file is generated by a pacman hook installed alongside us, for our benefit
: "${UPGRADED:=/run/automatic-upgrades/packages}"

# Having arch-automatic-upgrades-aur opts in to automatic AUR upgrades.
# It provides pikaur and the unprivileged automatic-upgrades user it needs.
aur=
if pacman -Q arch-automatic-upgrades-aur >/dev/null 2>&1; then
	aur=1
else
  # quick is useless without the AUR helper package
  quick=
fi

# Upgrade the system
if [ -z "$aur" ]; then
	pacman -Syu --noconfirm || exit 1
else
	sudo -u automatic-upgrades pikaur -Syu --noconfirm || exit 1
fi

# Find AUR packages that broke due to dependencies shifting under them.
# see checkrebuild(1).
(
	if [ -n "$quick" ]; then
		# only check what was upgraded, if any
		if [ -s "$UPGRADED" ]; then
			checkrebuild < "$UPGRADED"
		fi
	else
		# empty stdin to checkrebuild is the SLOW exhaustive case.
		checkrebuild < /dev/null
	fi
) | awk '{ print $2 }' | (
	if [ -z "$aur" ]; then
		# without pikaur we can't fix these
		if sed 's/^/  /' | grep . >&2; then
			echo "arch-automatic-upgrades: the packages above need rebuilding." >&2
			exit 1
		fi
	else
	  # pipe the packages to rebuild into pikaur
		xargs -r sudo -u automatic-upgrades pikaur -S --noconfirm --rebuild
	fi
) || exit 1

if [ -n "$aur" ]; then
  # clean up *only on success*
  # (that way, we know every package has been validated)
  rm -f "$UPGRADED"
fi
